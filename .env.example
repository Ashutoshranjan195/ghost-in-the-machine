# =================================================================
# Echoes — The Offline Memory Keeper (.env)
# 100% Offline, Privacy-First Architecture
# =================================================================

# Local Ollama Inference Endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Default Model Selection (open-weight, local inference)
# Options: llama3.2:3b, qwen2.5:3b, gemma2:2b, mistral:7b
OLLAMA_MODEL=qwen2.5:3b

# Local Embeddings & Whisper
EMBEDDING_MODEL=all-MiniLM-L6-v2
WHISPER_MODEL=base

# Privacy Enforcement (Always True)
OFFLINE_MODE_ENFORCED=true
ALLOW_EXTERNAL_APIS=false
